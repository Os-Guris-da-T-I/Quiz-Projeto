-- ============================================================
-- CONSULTAS (o que a API vai precisar buscar)
-- ============================================================

-- C01. Top 10 partidas do ranking geral.
-- Junta ranking com login só para mostrar o nome_login em vez do número do usuário.
-- ORDER BY: mais acertos primeiro e, se empatar, ganha quem terminou antes (data_partida mais antiga).
-- LIMIT 10 corta nas 10 primeiras linhas.
-- Resultado com os dados de teste (só tem 7 partidas, então aparecem 7):
--    jogador  |  modo   | acertos | total_perguntas |    data_partida
--   ----------+---------+---------+-----------------+---------------------
--    bruno_ti | dificil |      15 |              15 | 2026-10-29 18:20:00
--    ana_dev  | normal  |      14 |              15 | 2026-10-27 19:10:00
--    bruno_ti | normal  |      13 |              15 | 2026-10-27 21:00:00
--    ana_dev  | facil   |      12 |              15 | 2026-10-26 14:30:00
--    carla_c  | normal  |      11 |              15 | 2026-10-30 16:40:00
--    ana_dev  | dificil |      10 |              15 | 2026-10-28 20:45:00
--    carla_c  | facil   |       9 |              15 | 2026-10-28 10:15:00
SELECT l.nome_login AS jogador, r.modo, r.acertos, r.total_perguntas, r.data_partida
FROM ranking r
JOIN login l ON l.id_usuario = r.id_usuario
ORDER BY r.acertos DESC, r.data_partida ASC
LIMIT 10;

-- C02. Melhor pontuação de cada jogador em cada modo.
-- GROUP BY junta as partidas do mesmo jogador e modo, e o MAX pega a maior pontuação do grupo.
-- Trocando o WHERE (por exemplo WHERE r.modo = 'dificil') dá para ter o ranking de um modo só.
-- Resultado com os dados de teste (7 linhas, ordenadas por modo):
--    jogador  |  modo   | melhor_pontuacao
--   ----------+---------+------------------
--    bruno_ti | dificil |               15
--    ana_dev  | dificil |               10
--    ana_dev  | facil   |               12
--    carla_c  | facil   |                9
--    ana_dev  | normal  |               14
--    bruno_ti | normal  |               13
--    carla_c  | normal  |               11
SELECT l.nome_login AS jogador, r.modo, MAX(r.acertos) AS melhor_pontuacao
FROM ranking r
JOIN login l ON l.id_usuario = r.id_usuario
GROUP BY l.nome_login, r.modo
ORDER BY r.modo, melhor_pontuacao DESC, l.nome_login;

-- C03. O que a API busca quando alguém tenta fazer login.
-- Procura pelo nome_login e devolve os dados do usuário mais o hash. O Flask compara o hash com a senha
--   digitada usando check_password_hash, quem confere a senha é o Python e não o SQL.
-- Se não voltar nenhuma linha, o nome_login não existe.
-- Resultado (a senha_hash vem como um texto comprido, cortei aqui):
--    id_usuario |   nome    |      email      | senha_hash
--   ------------+-----------+-----------------+----------------------------
--             1 | Ana Teste | ana@example.com | scrypt:32768:8:1$Zcb2cg...
SELECT u.id_usuario, u.nome, u.email, l.senha_hash
FROM login l
JOIN usuario u ON u.id_usuario = l.id_usuario
WHERE l.nome_login = 'ana_dev';

-- ============================================================
-- COMANDOS QUE O FLASK VAI USAR (só exemplos, estão comentados)
-- ============================================================
-- Aqui o %s é o espaço onde o Python coloca o valor (usando psycopg2 ou psycopg).
-- Isso é importante: NUNCA montar o SQL juntando texto (f-string, +), porque dá SQL Injection
--   (a gente viu isso na pergunta fact-014 do quiz). Passar os valores separados resolve.
--
-- Cadastro (dois comandos, os dois na mesma transação):
--   INSERT INTO usuario (nome, email) VALUES (%s, %s) RETURNING id_usuario;
--   INSERT INTO login (id_usuario, nome_login, senha_hash) VALUES (%s, %s, %s);
--
-- Depois de logar com sucesso:
--   UPDATE login SET data_ultimo_acesso = CURRENT_TIMESTAMP WHERE id_usuario = %s;
--
-- Quando o jogador termina o quiz (tela final do script.js):
--   INSERT INTO ranking (id_usuario, modo, acertos, total_perguntas) VALUES (%s, %s, %s, %s);
