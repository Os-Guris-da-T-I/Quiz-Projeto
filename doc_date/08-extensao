-- Extensão — Usuários, Login e Ranking do Tech Trivia
-- Equipe 13: João Victor Guimarães Gomes, Gustavo Gabriel Naves Ferreira, Matheus Augusto Antunes Pentogennis, Lucas da Graça Leandro, Lucas Siqueira Teles e Gabriel Gonçalves Lima.
--
-- SGBD: PostgreSQL, o mesmo do 04-ddl.sql. Banco: tech_trivia.
-- Seguimos as regras do 00-como-entregar.md: nomes em português, minúsculos, sem acento, no singular,
--   e chave primária id_<tabela>.

BEGIN;

-- ============================================================
-- TABELA 1: usuario  (dados de usuários)
-- ============================================================
-- Cada linha é uma pessoa cadastrada no quiz.
-- Separei da tabela login para os dados da pessoa ficarem de um lado e a senha do outro,
--   assim quando a gente listar usuários o hash da senha nem vem junto.
CREATE TABLE usuario (
    id_usuario    INTEGER      GENERATED ALWAYS AS IDENTITY,        -- número do usuário (1, 2, 3...), o banco conta sozinho
    nome          VARCHAR(100) NOT NULL,                            -- nome da pessoa, até 100 caracteres
    email         VARCHAR(120) NOT NULL,                            -- email da pessoa, não pode repetir
    data_cadastro TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,  -- quando a conta foi criada; se a gente não mandar nada o banco coloca agora

    CONSTRAINT pk_usuario       PRIMARY KEY (id_usuario),           -- chave primária da tabela
    CONSTRAINT uq_usuario_email UNIQUE (email),                     -- impede dois cadastros com o mesmo email

    -- nome não pode ser vazio nem só espaços (btrim tira os espaços das pontas)
    CONSTRAINT ck_usuario_nome  CHECK (btrim(nome) <> ''),

    -- email tem que estar todo em minúsculo e ter um @ que não seja a primeira letra.
    -- Colocamos o minúsculo porque senão "Ana@x.com" e "ana@x.com" virariam duas contas.
    -- Então o Flask precisa mandar o email com .lower() antes de salvar.
    CONSTRAINT ck_usuario_email CHECK (email = lower(email) AND position('@' IN email) > 1)
);

-- ============================================================
-- TABELA 2: login  (dados de login)
-- ============================================================
-- Aqui fica o que a pessoa usa pra entrar: o nome de login e a senha.
-- Cada usuário tem um login só (1 para 1), e cada login é de um usuário só.
CREATE TABLE login (
    id_login           INTEGER      GENERATED ALWAYS AS IDENTITY,   -- número do login, gerado pelo banco
    id_usuario         INTEGER      NOT NULL,                       -- de qual usuário é esse login (FK lá embaixo)
    nome_login         VARCHAR(20)  NOT NULL,                       -- o nome que a pessoa digita pra entrar (também aparece no ranking)
    senha_hash         VARCHAR(255) NOT NULL,                       -- a senha já embaralhada (hash), NUNCA a senha de verdade
    data_ultimo_acesso TIMESTAMP,                                   -- último login; fica NULL (vazio) até a pessoa entrar a primeira vez

    CONSTRAINT pk_login         PRIMARY KEY (id_login),
    CONSTRAINT uq_login_usuario UNIQUE (id_usuario),                -- este UNIQUE é o que garante o 1 para 1: um usuário não ganha dois logins
    CONSTRAINT uq_login_nome    UNIQUE (nome_login),                -- dois jogadores não podem ter o mesmo nome de login

    -- só letra minúscula, número e _, de 3 a 20 caracteres (o ~ compara com uma expressão regular, igual no 04-ddl.sql)
    CONSTRAINT ck_login_nome    CHECK (nome_login ~ '^[a-z0-9_]{3,20}$'),

    -- o hash não pode vir vazio (não confere se é um hash bom, só que tem alguma coisa)
    CONSTRAINT ck_login_senha   CHECK (btrim(senha_hash) <> ''),

    -- liga o login ao usuário. ON DELETE CASCADE: se apagar o usuário, o login dele some junto,
    --   senão ia sobrar um login sem dono.
    CONSTRAINT fk_login_usuario FOREIGN KEY (id_usuario) REFERENCES usuario (id_usuario) ON DELETE CASCADE
);

-- Sobre a senha_hash: o banco não faz o hash, quem faz é o Flask.
--   Pelo que a gente viu, no Python dá para usar o werkzeug, que já vem junto com o Flask:
--     from werkzeug.security import generate_password_hash, check_password_hash
--     hash = generate_password_hash(senha_digitada)          -- na hora de cadastrar
--     check_password_hash(hash_do_banco, senha_digitada)     -- na hora de logar (devolve True ou False)
--   O VARCHAR(255) é grande de propósito porque esse hash é comprido (uns 160 caracteres).

-- ============================================================
-- TABELA 3: ranking
-- ============================================================
-- Cada linha é uma partida terminada: quem jogou, em qual modo e quantas acertou.
-- Um usuário pode ter várias linhas (1 usuário, N partidas), por isso a FK fica aqui e não no usuario.
CREATE TABLE ranking (
    id_ranking      INTEGER     GENERATED ALWAYS AS IDENTITY,        -- número da partida, gerado pelo banco
    id_usuario      INTEGER     NOT NULL,                            -- quem jogou (FK lá embaixo)
    modo            VARCHAR(10) NOT NULL,                            -- facil, normal ou dificil (mesmos valores do data-modo no index.html)
    acertos         SMALLINT    NOT NULL,                            -- quantas perguntas acertou (a variável "pontuacao" do script.js)
    total_perguntas SMALLINT    NOT NULL,                            -- de quantas perguntas era o quiz nessa partida
    data_partida    TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP,  -- quando terminou; padrão é a hora de agora

    CONSTRAINT pk_ranking PRIMARY KEY (id_ranking),

    -- só aceita os 3 modos que existem no quiz, qualquer outro texto dá erro
    CONSTRAINT ck_ranking_modo CHECK (modo IN ('facil', 'normal', 'dificil')),

    -- precisa ter pelo menos 1 pergunta
    CONSTRAINT ck_ranking_total CHECK (total_perguntas > 0),

    -- acertos não pode ser negativo nem maior que o total (não dá pra acertar 16 de 15)
    CONSTRAINT ck_ranking_acertos CHECK (acertos >= 0 AND acertos <= total_perguntas),

    -- se o usuário for apagado, as partidas dele saem do ranking também
    CONSTRAINT fk_ranking_usuario FOREIGN KEY (id_usuario) REFERENCES usuario (id_usuario) ON DELETE CASCADE
);

-- Guardei o total_perguntas em cada partida porque o quiz hoje tem 15 perguntas (script.js e app.py)
--   mas a documentação fala em 20. Se o número mudar, as partidas antigas continuam certas.

-- Índices: servem para o banco achar as coisas mais rápido.
-- Esse primeiro ajuda na consulta do ranking (filtra por modo e ordena pelos acertos do maior pro menor).
CREATE INDEX idx_ranking_modo_acertos ON ranking (modo, acertos DESC);
-- Esse segundo ajuda a buscar as partidas de um usuário. Pelo que a gente leu, o PostgreSQL não cria índice
--   sozinho para chave estrangeira (para a PK e o UNIQUE ele cria), então criamos na mão.
CREATE INDEX idx_ranking_usuario ON ranking (id_usuario);

